const overlay = document.createElement("div");
overlay.className = "modal-overlay";

class NotificationSystem {
constructor() {
this.container = document.querySelector('.notification-container') || document.createElement('div');
this.container.className = 'notification-container';
document.body.appendChild(this.container);
this.notifications = [];
}

show({ type='info', title=this.getDefaultTitle(type), message='', duration=5000, closable=true, showProgress=true, onClose=null } = {}) {    
const n = document.createElement('div');    
n.className = `notification ${type}`;    
const icon = this.getIcon(type);    
n.innerHTML = `    
    <div class="notification-icon">${icon}</div>    
    <div class="notification-content">    
    <div class="notification-title">${title}</div>    
    ${message ? `<div class="notification-message">${message}</div>` : ''}    
    </div>    
    ${closable ? '<button class="notification-close">×</button>' : ''}    
    ${showProgress && duration>0 ? '<div class="notification-progress"></div>' : ''}    
`;    
if (closable) n.querySelector('.notification-close').onclick = () => this.close(n, onClose);    
this.container.appendChild(n);    
this.notifications.push(n);    

if (duration > 0) {    
    const bar = n.querySelector('.notification-progress');    
    if (bar && showProgress) {    
    bar.style.transition = `transform ${duration}ms linear`;    
    setTimeout(()=>bar.style.transform='scaleX(0)',10);    
    }    
    setTimeout(()=>this.close(n,onClose),duration);    
}    
}    

close(n,cb){ n.classList.add('closing'); setTimeout(()=>{n.remove(); if(cb)cb();},400); }    
getIcon(t){ return {success:'✓',error:'✕',warning:'!',info:'i'}[t]||'i'; }    
getDefaultTitle(t){ return {success:'Sucesso!',error:'Erro!',warning:'Atenção!',info:'Informação'}[t]||'Info'; }    
success(m,o={}){this.show({...o,type:'success',message:m});}    
error(m,o={}){this.show({...o,type:'error',message:m});}    
warning(m,o={}){this.show({...o,type:'warning',message:m});}    
info(m,o={}){this.show({...o,type:'info',message:m});}    
}

const STYLE = document.createElement("style");
STYLE.innerHTML = `
* { margin: 0; padding: 0; box-sizing: border-box; }

body {    
    font-family: 'SF Pro Display', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;    
